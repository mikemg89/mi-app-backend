generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma" // Opcional: define una carpeta para el cliente generado
}

datasource db {
  provider = "postgresql"
  // La línea 'url' se elimina de aquí
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  phoneNumber     String?        @unique
  passwordHash    String
  role            Role           @default(USER)
  status          UserStatus     @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  videoStatus     VideoStatus    @default(NONE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  otps            EmailOtp[]
  videos          VideoVerification[]

  @@index([status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  familyId  String    @default(uuid())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// Código de invitación de un solo uso. Sin invitación no hay registro (ADR-009).
model Invite {
  id        String    @id @default(uuid())
  code      String    @unique
  createdBy String?
  usedById  String?   @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

/// Código OTP de 6 dígitos para verificar el email. Se guarda hasheado.
model EmailOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

/// Estado de la verificación por video-selfie (paso 2 del MVP).
enum VideoStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/// Estado de un intento concreto de verificación por video.
enum VerificationStatus {
  AWAITING_UPLOAD
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/// Un intento de verificación por video-selfie.
/// El código de desafío lo genera el servidor y aparece en pantalla mientras se graba:
/// así el video no se puede pregrabar.
model VideoVerification {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   String
  status      VerificationStatus @default(AWAITING_UPLOAD)
  storagePath String?
  mimeType    String?
  sizeBytes   Int?
  uploadedAt  DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?
  reason      String?
  expiresAt   DateTime
  purgeAt     DateTime?
  createdAt   DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([status])
}
