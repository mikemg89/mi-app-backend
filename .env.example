# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL local)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/miappdecitas?schema=public"

# Genera cada secreto con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcional: orígenes permitidos separados por coma. Si se omite, se permite cualquiera.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Opcional: número de proxies de confianza delante de la app (por ejemplo 1 en Render/Heroku)
# TRUST_PROXY=1

# Correo: "console" imprime el mensaje en la terminal (desarrollo, costo $0).
# "memory" solo se usa en tests.
MAIL_DRIVER=console

# Clave para crear invitaciones desde /api/admin/invites (mínimo 32 caracteres).
# Si se omite, el endpoint queda deshabilitado (503).
# Genera una con: openssl rand -hex 32
ADMIN_API_KEY=

# Bot de Telegram para revisar los videos de verificación.
# 1. Habla con @BotFather en Telegram y crea un bot con /newbot.
# 2. Pega aquí el token que te da.
# 3. Escríbele algo al bot y visita https://api.telegram.org/bot<TOKEN>/getUpdates
#    para obtener tu chat id (campo "chat": { "id": ... }).
# Si falta cualquiera de las dos, el video queda PENDING_REVIEW y se revisa
# con /api/verification/review usando la clave de administración.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Carpeta donde se guardan los videos (se borran al revisarlos).
UPLOAD_DIR=uploads
