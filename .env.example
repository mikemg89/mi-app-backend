# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# Base de datos (PostgreSQL local)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/miappdecitas?schema=public"

# Genera cada secreto con: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Opcional: orígenes permitidos separados por coma. Si se omite, se permite cualquiera.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Opcional: número de proxies de confianza delante de la app (por ejemplo 1 en Render/Heroku)
# TRUST_PROXY=1
